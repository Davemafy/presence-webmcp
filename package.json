{
  "name": "presence-agent-admission",
  "private": true,
  "version": "1.5.13",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run smoke && npm run acceptance && npm run aurora && npm run product && npm run navigation && npm run evidence && tsc -b && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "evidence": "vitest run src/tests/evidence.test.ts --reporter=json --outputFile=.evidence-results.json && node scripts/write-evidence.mjs",
    "acceptance": "node scripts/editor-acceptance.mjs",
    "aurora": "node scripts/aurora-acceptance.mjs",
    "product": "node scripts/product-layer-acceptance.mjs",
    "navigation": "node scripts/navigation-acceptance.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zustand": "latest",
    "@supabase/supabase-js": "latest",
    "qrcode": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "@types/qrcode": "latest"
  }
}
